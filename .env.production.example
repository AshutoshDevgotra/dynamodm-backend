NODE_ENV=production
MONGODB_URI=your-production-mongodb-connection-string
REDIS_URL=your-production-redis-connection-string
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=replace-with-a-64-character-hex-key
FRONTEND_URL=https://orangeflow.in
CLIENT_URL=https://orangeflow.in

INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_REDIRECT_URI=https://api.v1.orangeflow.in/api/instagram/callback
WEBHOOK_VERIFY_TOKEN=replace-with-a-random-webhook-token

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://api.v1.orangeflow.in/api/auth/google/callback

RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

GEMINI_API_KEY=your-gemini-api-key

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=no-reply@your-verified-domain.com
