NODE_ENV=production
MONGODB_URI=your-production-mongodb-connection-string
REDIS_URL=your-production-redis-connection-string
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=replace-with-a-64-character-hex-key
FRONTEND_URL=https://dynamodm-frontend.vercel.app
CLIENT_URL=https://dynamodm-frontend.vercel.app

INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_REDIRECT_URI=https://dynamodm-backend.onrender.com/api/instagram/callback
WEBHOOK_VERIFY_TOKEN=replace-with-a-random-webhook-token

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://dynamodm-backend.onrender.com/api/auth/google/callback

RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

GEMINI_API_KEY=your-gemini-api-key

SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=no-reply@your-domain.com
