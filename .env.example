NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/dynamodm
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=replace-with-a-64-character-hex-key
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/instagram/callback
WEBHOOK_VERIFY_TOKEN=replace-with-a-random-webhook-token

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

GEMINI_API_KEY=your-gemini-api-key

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=no-reply@example.com
# For Gmail SMTP, use smtp.gmail.com with a Google app password (not your Gmail password).
